---
import BaseLayout from '../layouts/BaseLayout.astro';
import UsagePanel from '../components/UsagePanel.astro';
import { ArrowUpRight, Sparkles } from 'lucide-react';
import { subjects } from '../lib/catalog';
const mapPhases = [
  { title: 'Understand the landscape', range: [1, 6], description: 'Start with shared language, information, people and the decisions that govern security.' },
  { title: 'Design trustworthy systems', range: [7, 14], description: 'Turn principles into architecture, identity, networks, platforms and software.' },
  { title: 'Operate, respond and investigate', range: [15, 19], description: 'Detect what changed, contain incidents, examine evidence and test defenses.' },
  { title: 'Apply to emerging and critical settings', range: [20, 23], description: 'Carry the same reasoning into AI, post-quantum, industrial and critical systems.' },
];
const areaRoles: Record<string, string> = {
  'cybersecurity': 'The common vocabulary for threats, controls and systems.',
  'information-security': 'Connects cyber controls to information value and handling.',
  'data-governance': 'Makes ownership, lineage and data decisions explicit.',
  'privacy-data-protection': 'Adds purpose, rights and protection across the data lifecycle.',
  'security-governance-risk-compliance': 'Turns technical choices into accountable risk decisions.',
  'human-factors-policy': 'Connects policies and human behavior to real operating conditions.',
  'security-architecture': 'Transforms requirements into defensible system boundaries.',
  'cryptography-trust': 'Gives systems verifiable confidentiality, integrity and trust.',
  'web3-blockchain-security': 'Applies assurance to decentralized protocols and assets.',
  'identity-access': 'Decides who can do what, when and with whose authority.',
  'network-communications': 'Protects the paths that connect identities and systems.',
  'systems-endpoints-hardware': 'Secures the hosts, devices and execution layers underneath.',
  'cloud-containers': 'Applies boundaries and ownership to distributed infrastructure.',
  'application-supply-chain': 'Builds assurance into software and its dependencies.',
  'security-operations-blue-team': 'Turns telemetry and controls into sustained detection.',
  'incident-response-resilience': 'Coordinates decisions, evidence, containment and recovery.',
  'digital-forensics-malware': 'Tests incident hypotheses against preserved artifacts.',
  'threat-intelligence-osint': 'Adds external context while distinguishing claims from evidence.',
  'offensive-security-red-team': 'Tests assumptions through authorized, bounded adversarial work.',
  'ai-security': 'Extends assurance to models, data and AI-enabled workflows.',
  'quantum-post-quantum-security': 'Plans for changing cryptographic assumptions and migration.',
  'ot-iot-security': 'Adapts security to physical processes, devices and safety.',
  'critical-sector-security': 'Integrates the whole path where service failure has broad impact.',
};
const areaBridges: Record<string, string> = {
  'cybersecurity': 'Shared security vocabulary gives Information security a way to name the information worth protecting.',
  'information-security': 'Information value leads to Data governance: who owns it, where it moves and how it is used.',
  'data-governance': 'Ownership and lineage make Privacy and data protection decisions more precise.',
  'privacy-data-protection': 'Data rights and purpose become accountable choices in Security governance, risk and compliance.',
  'security-governance-risk-compliance': 'Governance needs people who can carry it out; Human factors and policy examines that reality.',
  'human-factors-policy': 'People and rules set requirements that Security architecture must make operational.',
  'security-architecture': 'Architecture needs verifiable trust mechanisms; Cryptography supplies some of them.',
  'cryptography-trust': 'Trust assumptions are stress-tested in decentralized systems and cryptoassets.',
  'web3-blockchain-security': 'Identity and access connects trust mechanisms to people, services and authority.',
  'identity-access': 'Authorized identities use communication paths; Network security protects those paths.',
  'network-communications': 'Network controls depend on the endpoints and hardware at either end.',
  'systems-endpoints-hardware': 'Host boundaries extend into Cloud and container operations.',
  'cloud-containers': 'Cloud workloads are built and updated through the Application supply chain.',
  'application-supply-chain': 'Deployed systems produce the signals that Security operations must interpret.',
  'security-operations-blue-team': 'Detection becomes useful when Incident response can make bounded, evidenced decisions.',
  'incident-response-resilience': 'Incident hypotheses need preserved evidence; Digital forensics tests them.',
  'digital-forensics-malware': 'Forensic observations gain context from Threat intelligence and OSINT.',
  'threat-intelligence-osint': 'External context becomes testable assumptions in authorized Offensive security exercises.',
  'offensive-security-red-team': 'The same bounded testing mindset helps examine AI systems and their workflows.',
  'ai-security': 'AI systems still depend on cryptography; Quantum and post-quantum planning revisits its assumptions.',
  'quantum-post-quantum-security': 'Migration planning must account for long-lived OT, IoT and physical systems.',
  'ot-iot-security': 'Physical-process constraints converge in Critical infrastructure and sector security.',
  'critical-sector-security': 'End of the suggested area route. Revisit any subject at a deeper level or follow its course lessons.',
};
---
<BaseLayout title="OpenCyber Academy — free cybersecurity lessons and guided practice" description="Learn cybersecurity for free with public lessons, worked examples, exercises and explained answers. Choose a subject and study level; no account required.">
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <div class="eyebrow"><span class="live-dot"></span> OPEN LIBRARY · PUBLIC SOURCE</div>
        <h1>Learn cybersecurity through <span class="gold-text">open lessons and practice.</span></h1>
        <p>Choose a subject and study level. Read published teaching, work through an example, try an exercise and compare the explained answer. Free to read, with no account required.</p>
        <div class="hero-actions"><a class="button gold" href="#comece"><Sparkles size={18} aria-hidden="true" /> Choose your path <ArrowUpRight size={16} aria-hidden="true" /></a><a class="button secondary" href="/courses/rapid-1-month/cybersecurity/chapters/en/1/">Read a sample lesson (English) <ArrowUpRight size={16} aria-hidden="true" /></a></div>
        <div class="hero-benefits"><div><strong>Open lessons</strong><span>Read without signing in</span></div><div><strong>Worked practice</strong><span>Examples, exercises and answers</span></div><div><strong>Clear next steps</strong><span>Follow published teaching</span></div></div>
      </div>
      <div class="hero-visual" aria-label="A preview of the subject learning map">
        <div class="preview-top"><span>OPEN CYBER ACADEMY / STUDY ROUTE</span><span>01—23</span></div>
        <div class="preview-current"><small>BEGIN WITH</small><strong><span>01</span> &nbsp; <span>Cybersecurity</span></strong><p>Learn the common language before specializing.</p></div>
        <div class="preview-line"><span>FOUNDATIONS</span><i></i><span>DESIGN</span><i></i><span>OPERATIONS</span><i></i><span>APPLICATION</span></div>
        <div class="preview-steps"><div><span>01</span> Understand the landscape</div><div><span>02</span> Design trustworthy systems</div><div><span>03</span> Operate and investigate</div><div><span>04</span> Apply in critical settings</div></div>
        <a href="#learning-map" class="preview-link">Explore the 23-area map <span aria-hidden="true">↘</span></a>
      </div>
    </div>
  </section>

  <section class="section usage-section"><div class="shell"><UsagePanel scope="site" /></div></section>

  <section class="section map-section" id="learning-map" aria-labelledby="map-title">
    <div class="shell">
      <div class="map-intro"><div><div class="eyebrow">THE LEARNING MAP</div><h2 id="map-title">Twenty-three areas. One connected route.</h2><p>Start at 01 and follow the suggested sequence, or open the area you need. Each one adds a different lens to the same security decisions. Choose a study level inside any area.</p></div><div class="map-intro-actions"><a class="button secondary" href="/subjects/">Browse every area ↗</a><button id="map-motion" class="map-motion" type="button" aria-pressed="false">Pause animation</button></div></div>
      <div class="learning-map">
        <div class="map-phases">
          {mapPhases.map((phase, phaseIndex) => <div class="map-phase" data-phase={phaseIndex}>
            <div class="map-phase-heading"><span class="map-phase-number">0{phaseIndex + 1}</span><div><h3>{phase.title}</h3><p>{phase.description}</p></div></div>
            <ol class="map-nodes" start={phase.range[0]}>
              {subjects.slice(phase.range[0] - 1, phase.range[1]).map((subject, subjectIndex) => <li>
                <a class="map-node" data-map-number={phase.range[0] + subjectIndex} data-map-role={areaRoles[subject.area]} data-map-bridge={areaBridges[subject.area]} data-map-area={subject.area} href={`/subjects/${subject.area}/?lang=en`}>
                  <span class="map-node-number">{String(phase.range[0] + subjectIndex).padStart(2, '0')}</span><span>{subject.title}</span>
                  {phase.range[0] + subjectIndex === 1 && <span class="map-node-marker">Start here</span>}
                  {phase.range[0] + subjectIndex === subjects.length && <span class="map-node-marker">Finish route</span>}
                  <span class="map-node-arrow" aria-hidden="true">↗</span>
                </a>
              </li>)}
            </ol>
          </div>)}
        </div>
        <aside class="map-focus" aria-label="Selected area">
          <div class="eyebrow">CURRENT STOP <span id="map-position">01 / 23</span></div>
          <h3 id="map-focus-title">Cybersecurity</h3><p id="map-focus-role">The common vocabulary for threats, controls and systems.</p>
          <div class="map-focus-bridge"><span>HOW IT CONNECTS</span><p id="map-focus-bridge">Begin with the shared concepts; then use them to understand how information must be protected.</p></div>
          <a id="map-focus-link" class="button gold" href="/subjects/cybersecurity/?lang=en">Explore this area ↗</a>
          <div class="map-progress"><div id="map-progress-fill"></div></div><small>Suggested order · explore freely · 9 levels in each area</small>
        </aside>
      </div>
    </div>
  </section>

  <section class="section start-section" id="comece">
    <div class="shell">
      <div class="section-head"><div class="eyebrow">START HERE</div><h2>Find your course, one choice at a time.</h2><p>Choose a route, then use the buttons to select your language, subject and level.</p></div>
      <div class="study-wizard card" id="study-wizard" aria-live="polite">
        <div class="wizard-top"><span id="wizard-step">STEP 1 OF 4</span><span id="wizard-trail">Your study route</span></div>
        <h3 id="wizard-question">How would you like to begin?</h3>
        <p id="wizard-help">Choose a subject or follow every subject in a level.</p>
        <div class="wizard-choices" id="wizard-choices" role="group" aria-label="Study choices"></div>
        <div class="wizard-footer"><button id="wizard-back" class="button secondary" type="button" hidden>← Back</button><span id="wizard-note">You can change your choice at any step.</span></div>
      </div>
      <p id="catalog-status" class="catalog-status" role="status">Loading the public catalog…</p>
    </div>
  </section>

  <section class="section philosophy">
    <div class="shell philosophy-grid"><div><div class="eyebrow">FROM CONCEPT TO PRACTICE</div><h2>Learning you can verify.</h2><p class="muted">Each course has one book. Subjects organize modules, weekly chapters group daily lessons, and each lesson has a worked example and an exercise. The reader shows what is published and keeps previous, index and next navigation close to each lesson.</p><a class="text-link" href="/read/?path=BOOK_STANDARD.md">Read the editorial standard →</a></div><div class="principles"><div><span>01</span><div><strong>Transparent source</strong><p>Open text with its course and edition identified.</p></div></div><div><span>02</span><div><strong>No entry barrier</strong><p>Read courses, books and exercises without an account.</p></div></div><div><span>03</span><div><strong>Ready for other AIs</strong><p>Public API, Markdown and read-only MCP server.</p></div></div></div></div>
  </section>

  <section class="section ai-strip"><div class="shell ai-inner"><div><div class="eyebrow">FOR SYSTEMS AND AGENTS</div><h2>A library other AIs can consult.</h2><p>ChatGPT, Claude, DAI and other tools can discover courses and read lessons through MCP or the open API. Every response identifies its public manuscript.</p></div><a class="button gold" href="/for-ai/">Explore MCP access →</a></div></section>
  <script>
    import { siteLanguage } from '../lib/i18n';
    type Course = { level: string; area: string; title: string; titles: Record<string,string>; number: number };
    type Catalog = { courses: Course[]; level_order: string[]; level_names: Record<string, Record<string,string>> };
    const status = document.getElementById('catalog-status')!;
    const wizard = document.getElementById('wizard-choices')!;
    const wording = {
      en: { route: 'How would you like to begin?', routeHelp: 'Choose a subject or follow every subject in a level.', subject: 'I know my subject', subjectHelp: 'Choose a language, then a subject and study level.', levelRoute: 'I want a whole level', levelHelp: 'Choose a language and level, then browse its 23 separate courses.', language: 'Which language would you like to study in?', languageHelp: 'You can switch editions later. Published lesson availability varies by language.', chooseSubject: 'Choose a subject', chooseLevel: 'Choose a study level', chooseCourse: 'Choose a course in this level', subjectHelpStep: 'Each subject has its own course and book.', levelHelpStep: 'Courses in this level are separate; select the one you want to open.', courseHelp: 'Choose one subject to open its course and lesson guide.', back: '← Back', note: 'You can change your choice at any step.', step: 'STEP', of: 'OF', loaded: 'Study routes are ready.', unavailable: 'The course catalog is temporarily unavailable.', browse: 'Browse courses by level →' },
      pt: { route: 'Como você prefere começar?', routeHelp: 'Escolha um tema ou percorra todos os temas de um nível.', subject: 'Já sei o tema', subjectHelp: 'Escolha o idioma, depois o tema e o nível de estudo.', levelRoute: 'Quero estudar um nível', levelHelp: 'Escolha o idioma e o nível para ver os 23 cursos separados.', language: 'Em qual idioma você quer estudar?', languageHelp: 'Você pode trocar a edição depois. Aulas disponíveis variam conforme o idioma.', chooseSubject: 'Escolha um tema', chooseLevel: 'Escolha um nível de estudo', chooseCourse: 'Escolha um curso deste nível', subjectHelpStep: 'Cada tema tem seu próprio curso e livro.', levelHelpStep: 'Os cursos deste nível são separados; abra aquele que quer estudar.', courseHelp: 'Escolha um tema para abrir o curso e o guia de aulas.', back: '← Voltar', note: 'Você pode alterar sua escolha em qualquer etapa.', step: 'ETAPA', of: 'DE', loaded: 'As trilhas de estudo estão prontas.', unavailable: 'O catálogo de cursos está temporariamente indisponível.', browse: 'Explorar cursos por nível →' },
      es: { route: '¿Cómo prefieres comenzar?', routeHelp: 'Elige un tema o recorre todos los temas de un nivel.', subject: 'Ya sé el tema', subjectHelp: 'Elige el idioma, luego el tema y el nivel de estudio.', levelRoute: 'Quiero estudiar un nivel', levelHelp: 'Elige el idioma y el nivel para ver los 23 cursos separados.', language: '¿En qué idioma quieres estudiar?', languageHelp: 'Puedes cambiar la edición después. Las lecciones disponibles varían según el idioma.', chooseSubject: 'Elige un tema', chooseLevel: 'Elige un nivel de estudio', chooseCourse: 'Elige un curso de este nivel', subjectHelpStep: 'Cada tema tiene su propio curso y libro.', levelHelpStep: 'Los cursos de este nivel son separados; abre el que quieres estudiar.', courseHelp: 'Elige un tema para abrir el curso y su guía de lecciones.', back: '← Volver', note: 'Puedes cambiar tu elección en cualquier etapa.', step: 'PASO', of: 'DE', loaded: 'Las rutas de estudio están listas.', unavailable: 'El catálogo de cursos no está disponible por ahora.', browse: 'Explorar cursos por nivel →' },
    };
    const label = wording[siteLanguage()];
    type Choice = { step: number; mode: 'subject' | 'level' | null; language: string | null; area: string | null; level: string | null };
    let choice: Choice = { step: 0, mode: null, language: null, area: null, level: null };
    const history: Choice[] = [];
    let data: Catalog | null = null;
    const proceed = (next: Partial<Choice>) => { history.push({ ...choice }); choice = { ...choice, ...next, step: choice.step + 1 }; renderWizard(); };
    const origin = (language: string) => language === 'en' ? 'https://opencyber.academy' : `https://${language}.opencyber.academy`;
    function addChoice(text: string, detail: string, action: () => void, href?: string) {
      const element = document.createElement(href ? 'a' : 'button');
      element.className = 'wizard-choice';
      if (href) (element as HTMLAnchorElement).href = href;
      else { (element as HTMLButtonElement).type = 'button'; element.addEventListener('click', action); }
      const heading = document.createElement('strong'); heading.textContent = text;
      const hint = document.createElement('span'); hint.textContent = detail;
      element.append(heading, hint); wizard.append(element);
    }
    function renderWizard() {
      if (!data) return;
      wizard.replaceChildren();
      const question = document.getElementById('wizard-question')!;
      const help = document.getElementById('wizard-help')!;
      const trail = document.getElementById('wizard-trail')!;
      document.getElementById('wizard-step')!.textContent = `${label.step} ${choice.step + 1} ${label.of} 4`;
      const parts = [choice.mode === 'subject' ? label.subject : choice.mode === 'level' ? label.levelRoute : '', choice.language?.toUpperCase(), choice.area?.replaceAll('-', ' '), choice.level ? data.level_names[choice.level][choice.language || 'en'] : ''].filter(Boolean);
      trail.textContent = parts.length ? parts.join(' / ') : label.note;
      (document.getElementById('wizard-back') as HTMLButtonElement).hidden = choice.step === 0;
      document.getElementById('wizard-note')!.textContent = label.note;
      if (choice.step === 0) {
        question.textContent = label.route; help.textContent = label.routeHelp;
        addChoice(label.subject, label.subjectHelp, () => proceed({ mode: 'subject' }));
        addChoice(label.levelRoute, label.levelHelp, () => proceed({ mode: 'level' }));
      } else if (choice.step === 1) {
        question.textContent = label.language; help.textContent = label.languageHelp;
        for (const [code, name] of [['en', 'English'], ['pt', 'Português'], ['es', 'Español']]) addChoice(name, code.toUpperCase(), () => proceed({ language: code }));
      } else if (choice.step === 2 && choice.mode === 'subject') {
        question.textContent = label.chooseSubject; help.textContent = label.subjectHelpStep;
        for (const course of data.courses.filter(course => course.level === data!.level_order[0])) addChoice(course.titles[choice.language!] || course.title, String(course.number).padStart(2, '0'), () => proceed({ area: course.area }));
      } else if (choice.step === 2) {
        question.textContent = label.chooseLevel; help.textContent = label.levelHelpStep;
        for (const level of data.level_order) addChoice(data.level_names[level][choice.language!] || data.level_names[level].en, '', () => proceed({ level }));
      } else if (choice.mode === 'subject') {
        question.textContent = label.chooseLevel; help.textContent = label.courseHelp;
        for (const level of data.level_order) addChoice(data.level_names[level][choice.language!] || data.level_names[level].en, '', () => {}, `${origin(choice.language!)}/courses/${level}/${choice.area}/start/?lang=${choice.language}`);
      } else {
        question.textContent = label.chooseCourse; help.textContent = label.levelHelpStep;
        for (const course of data.courses.filter(course => course.level === choice.level)) addChoice(course.titles[choice.language!] || course.title, String(course.number).padStart(3, '0'), () => {}, `${origin(choice.language!)}/courses/${choice.level}/${course.area}/start/?lang=${choice.language}`);
      }
    }
    document.getElementById('wizard-back')?.addEventListener('click', () => { const previous = history.pop(); if (previous) { choice = previous; renderWizard(); } });
    try {
      const response = await fetch('/api/catalog');
      if (!response.ok) throw new Error('Catalog unavailable');
      data = await response.json() as Catalog;
      renderWizard(); status.textContent = label.loaded;
    } catch {
      status.textContent = label.unavailable;
      wizard.replaceChildren(); addChoice(label.browse, '', () => {}, '/levels/');
    }

    const mapNodes = [...document.querySelectorAll<HTMLAnchorElement>('.map-node')];
    const mapMotion = document.getElementById('map-motion') as HTMLButtonElement;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let activeMapIndex = 0;
    let mapPaused = reducedMotion.matches;
    let mapInspecting = false;
    let mapTimer: number | undefined;
    function selectArea(index: number): void {
      const node = mapNodes[index];
      if (!node) return;
      activeMapIndex = index;
      mapNodes.forEach((item, position) => item.classList.toggle('is-active', position === index));
      document.querySelectorAll<HTMLElement>('.map-phase').forEach(phase => phase.classList.toggle('is-active', phase.contains(node)));
      const title = node.querySelector<HTMLElement>('span:nth-child(2)')?.textContent || '';
      document.getElementById('map-position')!.textContent = `${String(index + 1).padStart(2, '0')} / ${mapNodes.length}`;
      document.getElementById('map-focus-title')!.textContent = title;
      document.getElementById('map-focus-role')!.textContent = node.dataset.mapRole || '';
      document.getElementById('map-focus-bridge')!.textContent = node.dataset.mapBridge || '';
      const link = document.getElementById('map-focus-link') as HTMLAnchorElement;
      link.href = `/subjects/${node.dataset.mapArea}/?lang=${siteLanguage()}`;
      (document.getElementById('map-progress-fill') as HTMLElement).style.width = `${(index + 1) / mapNodes.length * 100}%`;
    }
    function syncMotion(): void {
      if (mapTimer) window.clearInterval(mapTimer);
      mapTimer = undefined;
      mapMotion.textContent = mapPaused ? 'Play animation' : 'Pause animation';
      mapMotion.setAttribute('aria-pressed', String(mapPaused));
      if (!mapPaused && !mapInspecting && !document.hidden) mapTimer = window.setInterval(() => selectArea((activeMapIndex + 1) % mapNodes.length), 3300);
    }
    mapNodes.forEach((node, index) => {
      node.addEventListener('pointerenter', () => selectArea(index));
      node.addEventListener('focus', () => selectArea(index));
      node.href = `/subjects/${node.dataset.mapArea}/?lang=${siteLanguage()}`;
    });
    const map = document.querySelector<HTMLElement>('.learning-map')!;
    map.addEventListener('pointerenter', () => { mapInspecting = true; syncMotion(); });
    map.addEventListener('pointerleave', () => { mapInspecting = false; syncMotion(); });
    map.addEventListener('focusin', () => { mapInspecting = true; syncMotion(); });
    map.addEventListener('focusout', event => { if (!map.contains(event.relatedTarget as Node)) { mapInspecting = false; syncMotion(); } });
    mapMotion.addEventListener('click', () => { mapPaused = !mapPaused; syncMotion(); });
    document.addEventListener('visibilitychange', syncMotion);
    reducedMotion.addEventListener('change', event => { mapPaused = event.matches; syncMotion(); });
    selectArea(0); syncMotion();
  </script>
</BaseLayout>

<style>
  .hero { min-height: 610px; padding: 90px 0 74px; background: var(--hero-gradient); border-bottom: 1px solid var(--line); }
  .hero-grid { display: grid; grid-template-columns: 1.02fr .98fr; gap: clamp(30px, 5vw, 76px); align-items: center; }
  .hero-copy { position: relative; z-index: 2; }
  .hero-copy h1 { font-size: clamp(2.7rem, 4.6vw, 4.35rem); line-height: 1.1; }
  .live-dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--gold); box-shadow: 0 0 0 5px var(--gold-soft); margin-right: 9px; }
  .hero-copy > p { color: var(--muted); font-size: 1.14rem; max-width: 590px; line-height: 1.7; }
  .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 29px; }
  .hero-benefits { display: flex; gap: 24px; margin-top: 47px; }
  .hero-benefits > div { border-left: 1px solid var(--line); padding-left: 18px; display: grid; line-height: 1.25; }
  .hero-benefits strong { font: 600 1.12rem 'Titillium Web', sans-serif; }
  .hero-benefits span { font-size: .78rem; color: var(--muted); margin-top: 5px; }
  .hero-visual { min-height: 440px; padding: 25px; display: flex; flex-direction: column; border: 1px solid color-mix(in srgb, var(--gold) 32%, var(--line)); border-radius: 5px; background: linear-gradient(150deg, var(--surface), var(--bg-2)); box-shadow: 0 24px 58px rgba(0,3,14,.18); }
  .preview-top { display: flex; justify-content: space-between; color: var(--muted); font-size: .72rem; font-weight: 600; letter-spacing: .12em; border-bottom: 1px solid var(--line); padding-bottom: 13px; }
  .preview-current { margin-top: 29px; }
  .preview-current small { color: var(--gold); font-size: .72rem; letter-spacing: .15em; }
  .preview-current strong { display: block; font-size: clamp(1.35rem, 2.1vw, 1.9rem); line-height: 1.2; margin: 6px 0; }
  .preview-current p { color: var(--muted); font-size: .87rem; }
  .preview-line { display: flex; align-items: center; gap: 7px; margin: 21px 0 22px; }
  .preview-line span { font-size: .6rem; letter-spacing: .08em; color: var(--gold); white-space: nowrap; }
  .preview-line i { flex: 1; border-top: 1px solid var(--gold); min-width: 6px; }
  .preview-steps { display: grid; gap: 8px; }
  .preview-steps div { display: flex; gap: 13px; align-items: center; padding: 8px 10px; border: 1px solid var(--line); background: var(--bg-2); font-size: .82rem; }
  .preview-steps span { color: var(--gold); font-weight: 600; }
  .preview-link { margin-top: auto; padding-top: 21px; color: var(--gold); display: flex; justify-content: space-between; font-size: .87rem; font-weight: 600; }
  .map-section { background: var(--bg-2); border-bottom: 1px solid var(--line); }
  .map-intro { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 30px; }
  .map-intro > div:first-child { max-width: 740px; }
