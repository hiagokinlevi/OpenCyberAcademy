---
import '../styles/global.css';
import '../styles/reader.css';
import '../styles/directory.css';
import '../styles/course.css';
import { BookOpen, FlaskConical, Grid2X2, MoonStar, UserRound, ArrowUpRight } from 'lucide-react';
const { title = 'OpenCyber Academy — free cybersecurity learning', description = 'Free, open cybersecurity courses, lessons and books for anyone who wants to protect people and technology.', structuredData, robots = 'index,follow,max-image-preview:large' } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, 'https://opencyber.academy').toString();
const schema = structuredData || [
  { '@context': 'https://schema.org', '@type': 'Organization', name: 'OpenCyber Academy', url: 'https://opencyber.academy/' },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: 'OpenCyber Academy', url: 'https://opencyber.academy/', inLanguage: 'en', isAccessibleForFree: true },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content="OpenCyber Academy" />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#070e1c" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {(['/', '/about/', '/share/'].includes(path)) && ['en', 'pt', 'es'].map(language =>
      <link rel="alternate" hreflang={language} href={`https://${language === 'en' ? '' : language + '.'}opencyber.academy${path}`} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="OpenCyber Academy" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://opencyber.academy/social-card.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="OpenCyber Academy — free cybersecurity education" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://opencyber.academy/social-card.png" />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
    <title>{title}</title>
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('open-cyber-academy-theme') || 'dark'; } catch (_) { document.documentElement.dataset.theme = 'dark'; }
      const supported = ['en', 'pt', 'es'];
      const domain = location.hostname.split('.');
      const hostnameLanguage = domain.length === 3 && domain.slice(1).join('.') === 'opencyber.academy' ? domain[0] : location.hostname === 'opencyber.academy' ? 'en' : null;
      const parameters = new URLSearchParams(location.search);
      const requested = (parameters.get('ui') || parameters.get('lang'))?.slice(0, 2).toLowerCase();
      const language = supported.includes(hostnameLanguage) ? hostnameLanguage : location.hostname === 'localhost' && supported.includes(requested) ? requested : 'en';
      document.documentElement.lang = language;
      document.documentElement.dataset.language = language;
    </script>
    <script is:inline src="/analytics.js" defer></script>
    <script is:inline src="/insights.js" defer></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <dialog id="language-offer" aria-labelledby="language-offer-title" aria-describedby="language-offer-text"><div class="eyebrow">LANGUAGE / IDIOMA</div><h2 id="language-offer-title">Study in your language?</h2><p id="language-offer-text">Your browser language is available on OpenCyber Academy.</p><div class="language-offer-actions"><button class="button gold" id="language-offer-switch" type="button">Switch language</button><button class="button secondary" id="language-offer-stay" type="button">Continue in English</button></div></dialog>
    <header class="site-header">
      <div class="shell nav">
        <a class="brand" href="/" aria-label="OpenCyber Academy, home"><span class="brand-mark"><img src="/favicon.svg" alt="" width="34" height="34" /></span><span class="brand-name">OpenCyber Academy</span></a>
        <div class="catalog-menus" aria-label="Browse courses">
          <details class="catalog-menu" data-mode="level"><summary>By level</summary><div class="catalog-menu-panel"><div class="catalog-menu-top"><a href="/levels/" data-language-link>All levels →</a><span>Choose a level, then a course</span></div><div class="catalog-menu-columns"><div class="catalog-menu-choices"></div><div class="catalog-menu-courses" aria-live="polite">Loading courses…</div></div></div></details>
          <details class="catalog-menu" data-mode="subject"><summary>By subject</summary><div class="catalog-menu-panel"><div class="catalog-menu-top"><a href="/subjects/" data-language-link>All subjects →</a><span>Choose a subject, then a level</span></div><div class="catalog-menu-columns"><div class="catalog-menu-choices"></div><div class="catalog-menu-courses" aria-live="polite">Loading courses…</div></div></div></details>
        </div>
        <nav class="nav-links" aria-label="Main navigation">
          <a href="/#comece" aria-current={path === '/' ? 'page' : undefined}><BookOpen size={16} aria-hidden="true" /> Start here</a>
          <a href="/tests/" aria-current={path === '/tests/' ? 'page' : undefined}><FlaskConical size={16} aria-hidden="true" /> Tests</a>
          <a href="/tabletop/" aria-current={path.startsWith('/tabletop/') ? 'page' : undefined}><Grid2X2 size={16} aria-hidden="true" /> TableTop</a>
          <a href="/account/#connect-ai" data-student-ai-link hidden>Connect your AI</a>
          <details class="utility-menu"><summary>Explore</summary><div class="utility-menu-panel">
            <a href="/calendar/" data-study-calendar-link aria-current={path === '/calendar/' ? 'page' : undefined}>Study calendar</a>
            <a href="/insights/" aria-current={path === '/insights/' ? 'page' : undefined}>Public activity</a>
            <a href="/for-ai/" aria-current={path === '/for-ai/' ? 'page' : undefined}>For AIs</a>
            <a href="/about/" aria-current={path === '/about/' ? 'page' : undefined}>About us</a>
            <a href="/share/" aria-current={path === '/share/' ? 'page' : undefined}>Share a lesson</a>
            <a href="/read/?path=BOOK_STANDARD.md">Editorial standard</a>
          </div></details>
        </nav>
        <div class="nav-actions">
          <label class="site-language"><span class="sr-only">Site language</span><select id="site-language" aria-label="Site language"><option value="en">EN</option><option value="pt">PT</option><option value="es">ES</option><option value="he">HE</option><option value="fr">FR</option><option value="ru">RU</option><option value="de">DE</option><option value="zh">ZH</option><option value="ja">JA</option></select></label>
          <button id="theme-toggle" class="icon-button" type="button" aria-label="Toggle light and dark theme" title="Toggle theme"><MoonStar size={18} aria-hidden="true" /></button>
          <a class="button secondary account-link" href="/account/"><UserRound size={16} aria-hidden="true" /> My area</a>
        </div>
        <details class="mobile-nav"><summary aria-label="Open site menu">Menu</summary><nav class="mobile-nav-panel" aria-label="Mobile navigation"><a href="/levels/">By level</a><a href="/subjects/">By subject</a><a href="/#comece">Start here</a><a href="/tests/">Tests</a><a href="/tabletop/">TableTop</a><a href="/insights/">Public activity</a><a href="/account/#connect-ai" data-student-ai-link hidden>Connect your AI</a><a href="/calendar/">Study calendar</a><a href="/for-ai/">For AIs</a><a href="/about/">About us</a><a href="/share/">Share a lesson</a><a href="/read/?path=BOOK_STANDARD.md">Editorial standard</a><a href="/account/">My area</a></nav></details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="footer">
      <div class="shell footer-inner">
        <span>© OpenCyber Academy · <span>Open learning library</span><small class="footer-usage">This page: <strong data-insight="page.views">—</strong> opt-in views in 30 days</small></span>
        <div class="footer-links"><a href="/levels/" data-language-link>By level</a><a href="/subjects/" data-language-link>By subject</a><a href="/tests/">Tests</a><a href="/tabletop/">TableTop</a><a href="/calendar/" data-study-calendar-link>Study calendar</a><a href="/insights/">Public activity</a><a href="/for-ai/">API & MCP</a><a href="/about/">About us</a><a href="/share/">Share a lesson</a><a href="/read/?path=RIGHTS.md">Rights</a><a href="/privacy/">Privacy</a></div>
      </div>
    </footer>
    <script>
      import { translatePage, siteLanguage, editionLanguage } from '../lib/i18n';
      import { initializeCourseMenus } from '../lib/course-menu';
      const selector = document.getElementById('site-language') as HTMLSelectElement;
      const mobileNav = document.querySelector<HTMLDetailsElement>('.mobile-nav');
      mobileNav?.querySelectorAll('a').forEach(link => link.addEventListener('click', () => { mobileNav.open = false; }));
      selector.value = siteLanguage();
      selector.addEventListener('change', () => {
        try { const detected = navigator.language.slice(0, 2).toLowerCase(); localStorage.setItem('open-cyber-academy-language-choice', `${detected}:${selector.value === 'en' ? 'declined' : 'accepted'}`); } catch (_) { /* private mode */ }
        const origin = selector.value === 'en' ? 'https://opencyber.academy' : `https://${selector.value}.opencyber.academy`;
        const path = ['en', 'pt', 'es'].includes(selector.value) ? location.pathname : '/';
        const next = new URL(path, origin);
        location.href = next.href;
      });
      translatePage();
      void fetch('/auth/me', { credentials: 'same-origin', cache: 'no-store' }).then(session => {
        for (const link of document.querySelectorAll<HTMLElement>('[data-student-ai-link]')) link.hidden = !session.ok;
      }).catch(() => { /* Public navigation remains available if account storage is offline. */ });
      if (location.hostname === 'opencyber.academy' || location.hostname === 'www.opencyber.academy') {
        const browserLanguage = navigator.language.slice(0, 2).toLowerCase();
        if (browserLanguage === 'pt' || browserLanguage === 'es') {
          let choice: string | null = null;
          try { choice = localStorage.getItem('open-cyber-academy-language-choice'); } catch (_) { /* private mode */ }
          if (!choice || !choice.startsWith(`${browserLanguage}:`)) {
            const offer = document.getElementById('language-offer') as HTMLDialogElement;
            (document.getElementById('language-offer-title') as HTMLElement).textContent = browserLanguage === 'pt' ? 'Quer estudar em português?' : '¿Quieres estudiar en español?';
            (document.getElementById('language-offer-text') as HTMLElement).textContent = browserLanguage === 'pt' ? 'Detectamos português no seu navegador. Você pode mudar para o site em português ou continuar aqui em inglês.' : 'Detectamos español en tu navegador. Puedes cambiar al sitio en español o continuar aquí en inglés.';
            (document.getElementById('language-offer-switch') as HTMLElement).textContent = browserLanguage === 'pt' ? 'Ir para o site em português' : 'Ir al sitio en español';
            (document.getElementById('language-offer-stay') as HTMLElement).textContent = browserLanguage === 'pt' ? 'Continuar em inglês' : 'Continuar en inglés';
            document.getElementById('language-offer-switch')?.addEventListener('click', () => { try { localStorage.setItem('open-cyber-academy-language-choice', `${browserLanguage}:accepted`); } catch (_) { /* private mode */ } location.assign(`https://${browserLanguage}.opencyber.academy/`); });
            document.getElementById('language-offer-stay')?.addEventListener('click', () => { try { localStorage.setItem('open-cyber-academy-language-choice', `${browserLanguage}:declined`); } catch (_) { /* private mode */ } offer.close(); });
            offer.addEventListener('cancel', () => { try { localStorage.setItem('open-cyber-academy-language-choice', `${browserLanguage}:declined`); } catch (_) { /* private mode */ } });
            offer.showModal();
          }
        }
      }
      for (const anchor of document.querySelectorAll<HTMLAnchorElement>('a[data-language-link]')) {
        const target = new URL(anchor.href); target.searchParams.set('lang', editionLanguage()); target.searchParams.set('ui', siteLanguage()); anchor.href = target.href;
      }
      for (const anchor of document.querySelectorAll<HTMLAnchorElement>('a[data-study-calendar-link]')) {
        anchor.addEventListener('click', () => {
          const current = new URL(location.href);
          const course = current.pathname.match(/^\/courses\/([a-z0-9-]+)\/([a-z0-9-]+)\/?$/);
          const target = new URL('/calendar/', location.origin);
          const edition = (document.getElementById('course-language') as HTMLSelectElement | null)?.value || current.searchParams.get('lang') || editionLanguage();
          target.searchParams.set('lang', edition); target.searchParams.set('ui', siteLanguage());
          for (const key of ['level', 'area', 'start']) if (current.searchParams.has(key)) target.searchParams.set(key, current.searchParams.get(key)!);
          if (course) { target.searchParams.set('level', course[1]); target.searchParams.set('area', course[2]); }
          anchor.href = target.href;
        });
      }
      for (const anchor of document.querySelectorAll<HTMLAnchorElement>('a[data-test-link]')) {
        anchor.addEventListener('click', () => {
          const target = new URL(anchor.href);
          target.searchParams.set('lang', (document.getElementById('course-language') as HTMLSelectElement | null)?.value || editionLanguage());
          anchor.href = target.href;
        });
      }
      initializeCourseMenus();
      const toggle = document.getElementById('theme-toggle');
      toggle?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem('open-cyber-academy-theme', next); } catch (_) { /* private mode */ }
      });
    </script>
  </body>
</html>
